# Discord alerts — the ONLY delivery path
DISCORD_WEBHOOK_INFERENCE_WATCHDOG=

# Provider API keys (secrets — keep .env out of version control)
# Nous auth is a PATH POINTER, never a token copy: NOUS_AUTH_FILE points at
# the JSON file Hermes refreshes; the watchdog reads providers.nous.access_token
# from it at tick time, so the token is always fresh.
NOUS_AUTH_FILE=path/to/auth.json
TOKENROUTER_API_KEY=
KILOCODE_API_KEY=
AMD_API_KEY=
BAI_API_KEY=
# NVIDIA NIM (integrate.api.nvidia.com). On this box the key lives in
# ~/.hermes/.env, not the project .env; copy it here on other hosts.
NVIDIA_API_KEY=